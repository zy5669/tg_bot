# ============================================================
# Telegram Twitter 媒体下载机器人 - 环境变量示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram API（从 https://my.telegram.org 获取）
# 用于通过 MTProto 上传超过 Telegram Bot API 50 MB 限制的文件
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# Telethon session 文件名/路径（默认: 项目目录下 telegram_bot_api.session）
# TELEGRAM_SESSION_NAME=telegram_bot_api

# MTProto 上传保护上限（MB，默认 2000）
# MAX_TELEGRAM_API_FILE_SIZE_MB=2000

# 允许使用的 Telegram 用户 ID，逗号分隔（留空则允许所有人）
# ALLOWED_USERS=123456789,987654321

# 代理设置（可选，格式: http://host:port 或 socks5://host:port）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 调试模式（true/false）
# DEBUG=false

# 日志级别（DEBUG/INFO/WARNING/ERROR）
# LOG_LEVEL=INFO

